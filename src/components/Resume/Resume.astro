---
import './resume.scss';
import resumePdf from '/DamirResume2026.pdf';
import Tenure from '../Tenure/Tenure';
---

<main class='resume'>
  <section class='resume-container'>
    <header class='header'>
      <a
        aria-label='Learn more about Damir on the Hire Me page'
        href='/hireme'
        class='coffee'
      >
        <img src='/images/damir.jpg' class='resume-img' alt='Damir' />
      </a>
      <h1 class='headline'>
        Damir Harambasic
        <span class='hidden-text'>Resume | Staff Software Engineer, Frontend &amp; Design Systems</span>
        <span class='email-link'>
          <a
            href='https://www.linkedin.com/in/damirharambasic'
            rel='noopener noreferrer'
          >
            linkedin.com/in/damir
            <svg
              class='link-icon'
              focusable='false'
              aria-hidden='true'
              viewBox='0 0 24 24'
              height='18'
              width='18'
            >
              <path
                d='M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z'
              ></path>
            </svg>
          </a>
          <a href='mailto:damir.hara@gmail.com'>damir.hara@gmail.com</a>
          <a
            href='https://www.damir.fun'
            rel='noopener noreferrer'
            class='link'
          >
            www.damir.fun
            <svg
              class='link-icon'
              focusable='false'
              aria-hidden='true'
              viewBox='0 0 24 24'
              height='18'
              width='18'
            >
              <path
                d='M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z'
              ></path>
            </svg>
          </a>
        </span>
      </h1>
      <div class='resume-summary'>
        <h3 class='sub-headline'>SUMMARY</h3>
        <p class='summary-paragraph'>
          Staff Software Engineer with 10+ years of experience, mostly on the
          client side of web and native apps. Obsessive about the details in
          both design and code. Comfortable across the whole stack, from React
          Native and React down to GraphQL, Node.js and Postgres, but happiest
          building UI. Often brought onto high-profile projects, or ones that
          need polish and fixing, to get them across the finish line.
        </p>
      </div>
    </header>
    <section aria-label='Experience and background' class='main-section'>
      <section class='experience-container'>
        <h3 class='sub-headline'>EXPERIENCE</h3>
        <ul class='job-wrapper'>
          <li>
            <h4 class='company'>Varo Bank</h4>
            <h5>
              January 2020 - Present <Tenure
                startYear={2020}
                startMonth={1}
                client:only='react'
              />
            </h5>
            <ul class='role-list'>
              <li class='role-item'>
                <h5 class='role-title'>Staff Software Engineer</h5>
                <p class='role-dates'>
                  March 2024 - Present <Tenure
                    startYear={2024}
                    startMonth={3}
                    client:only='react'
                  />
                </p>
                <ul>
                  <li>
                    - Lead engineer on Pay Over Time, Pay Later; shipping
                    lending features from Figma to production.
                  </li>
                  <li>
                    - ~70% frontend (React Native/Expo, React web); the rest
                    on GraphQL/Node.js and our Kotlin/Postgres backend.
                  </li>
                  <li>
                    - The go-to engineer for the Design System; regularly pulled
                    into discussions on its changes and improvements.
                  </li>
                  <li>
                    - Set AI tooling standards (AGENTS.md templates,
                    prompts/evals, agentic workflows) and drove adoption.
                  </li>
                  <li>
                    - Integrated third-party services such as Statsig (feature
                    flags and experiments) and Column Tax (tax prep).
                  </li>
                  <li>
                    - Mentor and onboard engineers; hosted React workshops to
                    help our iOS and Android engineers ramp up.
                  </li>
                  <li>
                    - <strong>Technologies</strong>:
                    TypeScript, React Native (Expo), React (web), React Testing
                    Library, GraphQL, Node.js (Fastify), Kotlin, PostgreSQL.
                  </li>
                </ul>
              </li>
              <li class='role-item'>
                <h5 class='role-title'>Senior Software Engineer, Web</h5>
                <p class='role-dates'>January 2020 - March 2024</p>
                <ul>
                  <li>
                    - Built banking products start to finish across client
                    banking, growth, engagement and internal tools.
                  </li>
                  <li>
                    - Helped develop and launch the new bank.varomoney.com, and
                    led the web efforts to promote server-driven UI (SDUI).
                  </li>
                  <li>
                    - Collaborated on the complete Varo Bank app rewrite, moving
                    from native Swift and Android apps to React Native (Expo).
                  </li>
                  <li>
                    - Led a team of 3-4 engineers on the React Native rewrite of
                    the Settings page and its related sub-pages.
                  </li>
                  <li>
                    - One of the lead engineers on Design System 3.0, a React
                    Native (Expo) system for iOS, Android and web (40+
                    components).
                  </li>
                  <li>
                    - Before that, led web engineering on Design System 2.0:
                    Figma to tokens, accessible components and Storybook.
                  </li>
                  <li>
                    - Improved web accessibility: color contrast, focus and hover
                    states, and a "Skip to content" link for keyboard users.
                  </li>
                  <li>
                    - Part of the hiring committee: interviewed candidates, and
                    helped mentor and onboard new engineers.
                  </li>
                  <li>
                    - <strong>Technologies</strong>:
                    TypeScript, React, Storybook, GraphQL/Apollo, React Testing
                    Library.
                  </li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>

        <ul class='job-wrapper'>
          <li>
            <h4 class='company'>Overstock.com</h4>
            <h5>
              October 2014 - September 2018 &amp; October - December 2019
            </h5>
            <ul class='role-list'>
              <li class='role-item'>
                <h5 class='role-title'>Sr. Frontend Developer</h5>
                <p class='role-dates'>October 2019 - December 2019</p>
                <ul>
                  <li>
                    - Returned for a second stint to improve and maintain the
                    Product Details Page: new features and bug fixes.
                  </li>
                </ul>
              </li>
              <li class='role-item'>
                <h5 class='role-title'>
                  Frontend Developer, promoted to Sr. Frontend Developer
                </h5>
                <p class='role-dates'>October 2014 - September 2018</p>
                <ul>
                  <li>
                    - Shipped features and A/B tests on product pages and a
                    full-stack mobile web app.
                  </li>
                  <li>
                    - Worked closely with UX and Product to shape the design of
                    the features we built and tested.
                  </li>
                  <li>
                    - Created reusable React components and NPM modules used by
                    teams across Overstock.com.
                  </li>
                  <li>
                    - Built frontend workflow tooling for our repo, including
                    ES6 and ReactJS support.
                  </li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>

        <ul class='job-wrapper'>
          <li>
            <h4 class='company'>
              Sr. Full-Stack Developer <span class='span-light'>@</span> tZERO
              <span class='span-light'>(Medici Ventures, Overstock)</span>
            </h4>
            <h5>September 2018 - October 2019</h5>
            <ul>
              <li>
                - Designed and engineered (0-1) the UX for an innovative Web3
                product built on blockchain technology.
              </li>
              <li>
                - Served as acting Dev Lead: hired, mentored and guided the
                junior developers on the team.
              </li>
              <li>
                - Contributed to backend systems in Node.js, Express and
                PostgreSQL alongside the frontend work.
              </li>
            </ul>
          </li>
        </ul>
      </section>
      <section class='projects-container'>
        <h3 class='sub-headline'>SIDE PROJECTS</h3>
        <ul class='job-wrapper'>
          <li>
            <h4 class='company'>
              RackLab <span class='span-light'>&mdash;</span>
              <a
                class='job-link'
                href='https://racklab.tech'
                rel='noopener noreferrer'
              >
                racklab.tech
              </a>
            </h4>
            <ul>
              <li>
                - Rack planning tool for AV and IT pros: multi-rack
                drag-and-drop builder, undo/redo, AI equipment lookup, billing.
              </li>
              <li>
                - <strong>Built with</strong>: Next.js, TypeScript, Tailwind
                CSS, shadcn/ui, Supabase (Postgres), Stripe, Vercel AI SDK.
              </li>
              <li>
                - Currently building the companion mobile app, sharing the same
                Supabase backend as the web app.
              </li>
              <li>
                - <strong>Built with</strong>: Expo, React Native, TypeScript,
                NativeWind, Reanimated.
              </li>
            </ul>
          </li>
        </ul>

        <ul class='job-wrapper'>
          <li>
            <h4 class='company'>Flashkards</h4>
            <ul>
              <li>
                - Offline-first iOS/Android flashcard app: gesture-driven study,
                haptics, SQLite storage, OTA updates via EAS.
              </li>
              <li>
                - <strong>Built with</strong>: Expo, React Native, TypeScript,
                Reanimated, expo-sqlite, Zod.
              </li>
            </ul>
          </li>
        </ul>
      </section>
      <section class='skills-pill-container'>
        <div class='skills-title'>
          <h3 class='sub-headline'>SKILLS</h3>
        </div>
        <ul>
          <li class='main-skill'>JavaScript</li>
          <li>React</li>
          <li>React Native</li>
          <li>Jotai</li>
          <li>TypeScript</li>
          <li>GraphQL (Apollo)</li>
          <li>React Testing Library</li>
          <li class='cool-fact-container'>
            Astro <span class='cool-fact'>Used on this site! 🚀</span>
          </li>
          <li>Expo</li>
          <li>Reanimated</li>
          <li>Next.js</li>
          <li>Node.js</li>
          <li>Bun</li>
          <li class='main-skill'>CSS</li>
          <li>Figma (design to code)</li>
          <li>Design Systems</li>
          <li>Design Tokens</li>
          <li>Shadcn/ui</li>
          <li>Tailwind CSS (🙇‍♂️)</li>
          <li>SASS</li>
          <li>CSS Modules</li>
          <li>Responsive Design</li>
          <li>Storybook</li>
          <li class='main-skill'>Semantic HTML</li>
          <li>Wireframing &amp; Prototyping</li>
          <li>Accessibility</li>
          <li>Mentoring &amp; Advising</li>
          <li>Leadership</li>
        </ul>
      </section>
      <section class='education-container'>
        <h3 class='sub-headline'>EDUCATION</h3>
        <ul class='job-wrapper'>
          <h4>University of Utah</h4>
          <h5>Class of 2014</h5>
          <li>BS, Strategic Communication</li>
        </ul>
      </section>
    </section>
    <footer class='footer'>
      <a class='footer-button' href='mailto:damir.hara@gmail.com'>
        📧 Get In Touch
      </a>
      <a
        aria-label="Download Damir's resume as a PDF"
        class='footer-button'
        href={resumePdf}
      >
        💾 Download PDF
      </a>
      <a class='footer-button' href='/showcase'>🪩 Showcase</a>
    </footer>
  </section>
</main>
